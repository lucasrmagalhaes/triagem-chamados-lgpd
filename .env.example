PORT=3000
# Vazio: a API sobe com repositorio em memoria e classificador heuristico.
DATABASE_URL=postgres://triagem:triagem@localhost:5432/triagem
LIMIAR_CONFIANCA=0.72

# Chave do Vercel AI Gateway. Sem ela, a triagem usa o heuristico local.
AI_GATEWAY_API_KEY=
MODELO_TRIAGEM=google/gemini-2.5-flash-lite
MODELO_EMBEDDING=openai/text-embedding-3-small
# true troca o embedding local pelo modelo do gateway. Rode o seed de novo depois da troca.
USAR_EMBEDDING_GATEWAY=false
FORCAR_HEURISTICA=false

# Comparacao de custo versus acuracia. So chama modelo pago com AVALIACAO_REAL=true.
AVALIACAO_REAL=false
AVALIACAO_MODELOS=openai/gpt-5-nano,google/gemini-2.5-flash-lite,anthropic/claude-haiku-4.5

# Observabilidade opcional. Sem as chaves, nada e enviado ao Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# false omite o texto mascarado e a saida do modelo nos traces.
LANGFUSE_REGISTRAR_CONTEUDO=true
